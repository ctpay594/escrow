# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# User auth JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN_SECONDS=604800

# Admin auth JWT (separate secret — never expose to frontends)
ADMIN_JWT_SECRET=your-admin-jwt-secret
ADMIN_JWT_EXPIRES_IN_SECONDS=604800

# EscrowStack (backend only — never expose to frontends)
# Live Chakatalwar passthrough (see Live-Credential.postman_collection.json)
ESCROWSTACK_BASE_URL=https://cashdfcpt.escrowstack.io
ESCROWSTACK_PAYOUT_URL=https://cashdfcpt.escrowstack.io/v1/pt/hdfc/payout
# One company keypair — used for all merchants (never put on Vercel)
ESCROWSTACK_API_KEY=paste-live-jwt-here
ESCROWSTACK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nPASTE_FULL_KEY_HERE\n-----END PRIVATE KEY-----"
ESCROWSTACK_IFSC=HDFC0000060
ESCROWSTACK_VA_PREFIX=CHAK69
# Unused after migration 016 (keys no longer encrypted per merchant). Can stay for now.
ESCROW_AES_MASTER_KEY=change-this-to-a-long-random-secret
# Optional later: EscrowStack PEM public key for webhook signature verification
# ESCROWSTACK_WEBHOOK_PUBLIC_KEY=

# Supabase — Project Settings → API
# https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase — Project Settings → API → JWT Settings
# Used to verify user access tokens issued by Supabase Auth
SUPABASE_JWT_SECRET=your-jwt-secret
